# Copiar a .env (ignorado por git) y ajustar. Spring Boot NO lee este archivo por sí solo:
# exporte las variables en la terminal, o configúrelas en IntelliJ (Run Configuration → Environment variables).

# ---------- Servicio ----------
PORT=8080
# Valor de la cabecera X-Gateway-Secret que agrega el API Gateway. Vacío = filtro desactivado (solo desarrollo local).
GATEWAY_SECRET=

# ---------- Base de datos local (docker compose) ----------
# Puerto del host para el contenedor de PostgreSQL (cámbielo si 5432 está ocupado y ajuste la URL).
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cuentas
SPRING_DATASOURCE_USERNAME=cuentas
SPRING_DATASOURCE_PASSWORD=cuentas
# Conexiones máximas por instancia (el servidor de Azure es compartido).
DB_POOL_MAX=5

# ---------- Azure Database for PostgreSQL (ejemplo) ----------
# SPRING_DATASOURCE_URL=jdbc:postgresql://<servidor>.postgres.database.azure.com:5432/cuentas?sslmode=require
# SPRING_DATASOURCE_USERNAME=<usuario>
# SPRING_DATASOURCE_PASSWORD=<clave>
