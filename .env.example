# Copiar a .env (ignorado por git) y poner la contraseña real.
# - La app (API-CRUD) carga .env automáticamente (spring.config.import en application.properties).
# - docker compose también lee .env de la raíz del repositorio.
# Las variables de entorno del sistema tienen prioridad sobre .env.

# ---------- Servicio ----------
PORT=8080
# Valor de la cabecera X-Gateway-Secret que agrega el API Gateway (el filtro aún no está implementado).
GATEWAY_SECRET=

# ---------- Base de datos ----------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/rodar_cuentas
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=<clave>
# Conexiones máximas por instancia (el servidor de Azure es compartido).
DB_POOL_MAX=5

# ---------- Contenedor de PostgreSQL (docker compose) ----------
# Puerto del host (cámbielo si 5432 está ocupado y ajuste SPRING_DATASOURCE_URL).
POSTGRES_PORT=5432
POSTGRES_DB=rodar_cuentas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<clave>

# ---------- Azure Database for PostgreSQL (ejemplo) ----------
# SPRING_DATASOURCE_URL=jdbc:postgresql://<servidor>.postgres.database.azure.com:5432/rodar_cuentas?sslmode=require
# SPRING_DATASOURCE_USERNAME=<usuario>
# SPRING_DATASOURCE_PASSWORD=<clave>
